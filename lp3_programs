# DAA-2: Job Sequencing with Deadlines
# Using Greedy Algorithm

def job_sequencing(jobs):

    # Sort jobs in descending order of profit
    jobs.sort(key=lambda x: x[2], reverse=True)

    # Find maximum deadline
    max_deadline = max(job[1] for job in jobs)

    # Create empty time slots
    slots = [None] * max_deadline

    total_profit = 0

    # Schedule jobs
    for job in jobs:
        job_id, deadline, profit = job

        # Find the latest available slot
        for j in range(min(deadline, max_deadline) - 1, -1, -1):

            if slots[j] is None:
                slots[j] = job_id
                total_profit += profit
                break

    # Display scheduled jobs
    print("\nScheduled Jobs:")
    for i in range(max_deadline):
        if slots[i] is not None:
            print("Time Slot", i + 1, ":", slots[i])

    print("\nMaximum Profit:", total_profit)


# Main Program
