# ML-5: Implementation of Gradient Descent Algorithm to Minimize y=(x+3)^2
# ========================================================================

# Cell 1 – Import required libraries
import numpy as np
import matplotlib.pyplot as plt

print("Libraries imported successfully!")

# Cell 2 – Define the function and its derivative
# Define the objective function
def function(x):
    return (x + 3) ** 2

# Define the derivative of the function
def derivative(x):
    return 2 * (x + 3)

print("Function: f(x) = (x + 3)^2")
print("Derivative: f'(x) = 2(x + 3)")

# Cell 3 – Initialize parameters
# Initial value
x = 5

# Learning rate
learning_rate = 0.1

# Number of iterations
epochs = 50

# Store values for visualization
x_history = []
y_history = []

print("Initial x:", x)
print("Learning rate:", learning_rate)
print("Number of iterations:", epochs)

# Cell 4 – Implement the Gradient Descent Algorithm
# Gradient Descent Algorithm

for i in range(epochs):

    # Calculate gradient
    grad = derivative(x)

    # Update x
    x = x - learning_rate * grad

    # Calculate function value
    y = function(x)

    # Store values
    x_history.append(x)
    y_history.append(y)

    print("Iteration:", i + 1,
          "| x =", round(x, 6),
          "| y =", round(y, 8))

# Cell 5 – Display the final minimum value
print("Gradient Descent Completed!")

print("Final value of x:", x)
print("Minimum value of y:", function(x))

print("\nTheoretical Minimum:")
print("x = -3")
print("y = 0")

# Cell 6 – Plot the objective function
# Generate x values
x_values = np.linspace(-8, 5, 100)

# Calculate corresponding y values
y_values = function(x_values)

# Plot the function
plt.figure(figsize=(8, 5))

plt.plot(x_values, y_values, label="y = (x + 3)^2")

# Mark the minimum point
plt.scatter(-3, 0, color="red", s=100, label="Minimum Point (-3, 0)")

plt.xlabel("x")
plt.ylabel("y")
plt.title("Objective Function: y = (x + 3)^2")

plt.legend()
plt.grid(True)
plt.show()

# Cell 7 – Visualize the Gradient Descent process
plt.figure(figsize=(8, 5))

# Plot objective function
plt.plot(x_values, y_values, label="Objective Function")

# Plot gradient descent steps
plt.scatter(x_history, y_history,
            color="red", label="Gradient Descent Steps")

# Mark minimum
plt.scatter(-3, 0, color="green",
            s=100, label="Minimum Point")

plt.xlabel("x")
plt.ylabel("y")
plt.title("Gradient Descent Optimization")

plt.legend()
plt.grid(True)
plt.show()

# Cell 8 – Plot cost reduction over iterations
plt.figure(figsize=(8, 5))

plt.plot(range(1, epochs + 1), y_history, marker="o")

plt.xlabel("Number of Iterations")
plt.ylabel("Function Value (y)")

plt.title("Gradient Descent: Cost Reduction")

plt.grid(True)
plt.show()

# Cell 9 – Display the final result in a formatted way
print("-----------------------------------")
print("       GRADIENT DESCENT RESULT")
print("-----------------------------------")

print("Objective Function: y = (x + 3)^2")
print("Learning Rate:", learning_rate)
print("Total Iterations:", epochs)

print("Initial x: 5")
print("Final x:", round(x, 6))
print("Minimum y:", round(function(x), 8))

print("-----------------------------------")

