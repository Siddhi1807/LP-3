    for i in range(n):
        print(fibonacci_recursive(i), end=" ")

    # Non-Recursive Method
    print("\n\nFibonacci Series without Recursion:")
    result = fibonacci_non_recursive(n)

    for num in result:
        print(num, end=" ")

